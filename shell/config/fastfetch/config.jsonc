{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "$HOME/.config/fastfetch/dedsec.txt",
    "color": {
      "1": "#1BFD9C"
    },
    "padding": {
      "top": 1,
      "left": 7,
      "right": 10
    }
  },
  "display": {
    "color": {
      "keys": "#1BFD9C",
      "separator": "#7A7A7A",
      "output": "#FFFFFF"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#white}{1}{#}{#red}@{}{#green}{2}{#}"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#1BFD9C"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "ctOS-{version-id}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "blume-krn-{release}"
    },
    "uptime",
    "packages",
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#1BFD9C"
    },
    "shell",
    "de",
    "wm",
    "icons",
    "font",
    "terminal",
    "terminalfont",
    {
      "type": "custom",
      "key": "Theme",
      "format": "wnkz/monoglow.nvim"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#1BFD9C"
    },
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "break",
    "colors"
  ]
}
