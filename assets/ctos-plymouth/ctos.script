Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = Window.GetX() + (screen_w / 2);
center_y = Window.GetY() + (screen_h / 2);

background_source = Image("background.png");
background_image = background_source.Scale(screen_w, screen_h);
background = Sprite(background_image);
background.SetPosition(Window.GetX(), Window.GetY(), 0);

# Colors
# White: (1, 1, 1)
# Acid Green: (0.81, 1.0, 0.0)
# Dark Green / Dim: (0.3, 0.4, 0.0)

# 1. SCANLINE ANIMATION
scan_image = Image.Text("_________________________________________________________________________________________________________________________________________________________________", 0.81, 1.0, 0.0, 0.15, "Monospace 14", "center");
scan = Sprite(scan_image);
scan.SetZ(30);

# 2. CENTER TITLE
title_str = "ctOS";
title_image = Image.Text(title_str, 1, 1, 1, 1, "Monospace Bold 48", "center");
title_shadow_image = Image.Text(title_str, 0.81, 1.0, 0.0, 0.5, "Monospace Bold 48", "center");
title = Sprite(title_image);
title_shadow = Sprite(title_shadow_image);
title.SetZ(50);
title_shadow.SetZ(49);

title_w = title_image.GetWidth();
title_h = title_image.GetHeight();

# 3. SUBTITLE
sub_image = Image.Text("CENTRAL OPERATING SYSTEM", 0.81, 1.0, 0.0, 1, "Monospace 14", "center");
sub = Sprite(sub_image);
sub.SetZ(50);
sub.SetX(center_x - (sub_image.GetWidth() / 2));
sub.SetY(center_y + (title_h / 2) + 10);

# 4. FAST SCROLLING LOGS (Bottom Left)
log_lines = [];
log_lines[0] = "Mounting virtual filesystems...";
log_lines[1] = "Initializing cryptographic keys...";
log_lines[2] = "Bypassing hardware locks...";
log_lines[3] = "Loading proprietary Blume binaries...";
log_lines[4] = "Establishing secure DBus socket...";
log_lines[5] = "Spawning polkit agents...";
log_lines[6] = "Injecting kernel hooks...";
log_lines[7] = "Starting Wayland compositor...";
log_lines[8] = "Waking QML UI engines...";
log_lines[9] = "Validating system integrity...";
log_lines[10] = "Connecting to telemetry servers...";
log_lines[11] = "Synchronizing clock...";
log_lines[12] = "Handshake OK. Welcome.";

# Create 5 sprite slots for a scrolling terminal
log_sprites = [];
for (i = 0; i < 5; i++) {
    log_sprites[i] = Sprite();
    log_sprites[i].SetZ(60);
    log_sprites[i].SetX(Window.GetX() + 40); # 40px padding from left
    # Y positions will be dynamically updated
}

# 5. LOADING PROGRESS BAR (Bottom Center)
progress_sprites = [];
for (i = 0; i < 8; i++) {
    bars = "";
    for (j = 0; j < i; j++) bars += "###";
    for (j = i; j < 8; j++) bars += "   ";
    text = "[ " + bars + " ]";
    progress_sprites[i] = Image.Text(text, 0.81, 1.0, 0.0, 1, "Monospace Bold 16", "center");
}
progress = Sprite();
progress.SetZ(60);
progress.SetX(center_x - (progress_sprites[0].GetWidth() / 2));
progress.SetY(Window.GetY() + screen_h - 60); # 60px from bottom

frame = 0;
log_index = 0;

fun refresh_callback() {
    frame++;
    
    # Mathematics for animations
    pulse = (Math.Sin(frame / 10) + 1) / 2;
    glitch_active = (frame % 60) < 5; # Glitch every ~1 second for 5 frames
    jitter_x = 0;
    jitter_y = 0;
    if (glitch_active) {
        jitter_x = Math.Int(Math.Sin(frame * 13) * 6);
        jitter_y = Math.Int(Math.Cos(frame * 17) * 4);
    }
    
    # Background Dimming
    background.SetOpacity(0.5);

    # Scanline sweeping down the screen
    scan_y = Window.GetY() + ((frame * 15) % screen_h);
    scan.SetX(Window.GetX() + (screen_w / 2) - (scan_image.GetWidth() / 2));
    scan.SetY(scan_y);

    # Main Title with Glitch
    title.SetX(center_x - (title_w / 2) + jitter_x);
    title.SetY(center_y - (title_h / 2) - 20 + jitter_y);
    title_shadow.SetX(center_x - (title_w / 2) - 4 + jitter_x);
    title_shadow.SetY(center_y - (title_h / 2) - 18 + jitter_y);
    
    if (glitch_active) {
        title_shadow.SetOpacity(0.9);
        title.SetOpacity(0.7);
    } else {
        title_shadow.SetOpacity(0.0);
        title.SetOpacity(1.0);
    }

    sub.SetOpacity(0.6 + (pulse * 0.4));

    # Progress bar animation (updates every 6 frames)
    prog_idx = Math.Int(frame / 6) % 8;
    progress.SetImage(progress_sprites[prog_idx]);
    
    # Scrolling Logs
    if (frame % 8 == 0) {
        log_index++;
    }
    
    for (i = 0; i < 5; i++) {
        # Get the line index, clamping to the max array bound so it stops at the end
        line_idx = log_index + i - 4;
        if (line_idx >= 0 && line_idx < 13) {
            img = Image.Text("> " + log_lines[line_idx], 1, 1, 1, 0.8, "Monospace 11", "left");
            log_sprites[i].SetImage(img);
            log_sprites[i].SetY(Window.GetY() + screen_h - 130 + (i * 18));
            log_sprites[i].SetOpacity(0.3 + (i * 0.15)); # Fade in from top
        } else {
            # Empty image
            log_sprites[i].SetOpacity(0.0);
        }
    }

    Plymouth.SetRefreshFunction(refresh_callback);
}

Plymouth.SetRefreshFunction(refresh_callback);
