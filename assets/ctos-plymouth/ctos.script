Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = Window.GetX() + (screen_w / 2);
center_y = Window.GetY() + (screen_h / 2);

background_source = Image("background.png");
background_image = background_source.Scale(screen_w, screen_h);
background = Sprite(background_image);
background.SetPosition(Window.GetX(), Window.GetY(), 0);

scan_image = Image.Text(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>", 0.81, 1.0, 0.0, 0.15, "Monospace 14", "left");
scan = Sprite(scan_image);
scan.SetZ(30);

title_image = Image.Text("ctOS", 1, 1, 1, 1, "Monospace Bold 48", "left");
title_shadow_image = Image.Text("ctOS", 0.81, 1.0, 0.0, 0.5, "Monospace Bold 48", "left");
title = Sprite(title_image);
title_shadow = Sprite(title_shadow_image);
title.SetZ(50);
title_shadow.SetZ(49);

title_w = title_image.GetWidth();
title_h = title_image.GetHeight();

sub_image = Image.Text("CENTRAL OPERATING SYSTEM", 0.81, 1.0, 0.0, 1, "Monospace 14", "left");
sub = Sprite(sub_image);
sub.SetZ(50);
sub.SetX(center_x - (sub_image.GetWidth() / 2));
sub.SetY(center_y + (title_h / 2) + 10);

log_lines = [];
log_lines[0] = "> Mounting virtual filesystems...";
log_lines[1] = "> Initializing cryptographic keys...";
log_lines[2] = "> Bypassing hardware locks...";
log_lines[3] = "> Loading proprietary Blume binaries...";
log_lines[4] = "> Establishing secure DBus socket...";
log_lines[5] = "> Spawning polkit agents...";
log_lines[6] = "> Injecting kernel hooks...";
log_lines[7] = "> Starting Wayland compositor...";
log_lines[8] = "> Waking QML UI engines...";
log_lines[9] = "> Validating system integrity...";
log_lines[10] = "> Connecting to telemetry servers...";
log_lines[11] = "> Synchronizing clock...";
log_lines[12] = "> Handshake OK. Welcome.";

log_images = [];
for (i = 0; i < 13; i++) {
    log_images[i] = Image.Text(log_lines[i], 1, 1, 1, 0.8, "Monospace 11", "left");
}

log_sprites = [];
for (i = 0; i < 5; i++) {
    log_sprites[i] = Sprite();
    log_sprites[i].SetZ(60);
    log_sprites[i].SetX(Window.GetX() + 40);
    log_sprites[i].SetOpacity(0);
}

progress_text = [];
progress_text[0] = "[                        ]";
progress_text[1] = "[###                     ]";
progress_text[2] = "[######                  ]";
progress_text[3] = "[#########               ]";
progress_text[4] = "[############            ]";
progress_text[5] = "[###############         ]";
progress_text[6] = "[##################      ]";
progress_text[7] = "[#####################   ]";
progress_text[8] = "[########################]";

progress_sprites = [];
for (i = 0; i < 9; i++) {
    progress_sprites[i] = Image.Text(progress_text[i], 0.81, 1.0, 0.0, 1, "Monospace Bold 16", "left");
}

progress = Sprite(progress_sprites[0]);
progress.SetZ(60);
progress.SetX(center_x - (progress_sprites[0].GetWidth() / 2));
progress.SetY(Window.GetY() + screen_h - 60);

frame = 0;
log_index = 0;

fun refresh_callback() {
    frame++;
    
    pulse = (Math.Sin(frame / 10) + 1) / 2;
    flicker = (Math.Sin(frame * 3) + 1) / 2;
    jitter_x = 0;
    jitter_y = 0;
    
    glitch_active = 0;
    if ((frame % 60) < 5) {
        glitch_active = 1;
        jitter_x = Math.Int(Math.Sin(frame * 13) * 6);
        jitter_y = Math.Int(Math.Sin(frame * 17) * 4);
    }
    
    background.SetOpacity(0.5);

    scan_y = Window.GetY() + ((frame * 15) % screen_h);
    scan.SetX(Window.GetX());
    scan.SetY(scan_y);

    title.SetX(center_x - (title_w / 2) + jitter_x);
    title.SetY(center_y - (title_h / 2) - 20 + jitter_y);
    title_shadow.SetX(center_x - (title_w / 2) - 4 + jitter_x);
    title_shadow.SetY(center_y - (title_h / 2) - 18 + jitter_y);
    
    if (glitch_active == 1) {
        title_shadow.SetOpacity(0.9);
        title.SetOpacity(0.7);
    } else {
        title_shadow.SetOpacity(0.0);
        title.SetOpacity(1.0);
    }

    sub.SetOpacity(0.6 + (pulse * 0.4));

    prog_idx = Math.Int(frame / 6) % 9;
    progress.SetImage(progress_sprites[prog_idx]);
    
    if (frame % 8 == 0) {
        log_index++;
    }
    
    for (i = 0; i < 5; i++) {
        line_idx = log_index + i - 4;
        if (line_idx >= 0) {
            if (line_idx < 13) {
                log_sprites[i].SetImage(log_images[line_idx]);
                log_sprites[i].SetY(Window.GetY() + screen_h - 130 + (i * 18));
                log_sprites[i].SetOpacity(0.3 + (i * 0.15));
            } else {
                log_sprites[i].SetOpacity(0);
            }
        }
    }
    
    Plymouth.SetRefreshFunction(refresh_callback);
}

Plymouth.SetRefreshFunction(refresh_callback);
