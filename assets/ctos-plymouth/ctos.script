Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

background_source = Image("background.png");
background_image = background_source.Scale(screen_w, screen_h);
background = Sprite(background_image);
background.SetPosition(Window.GetX(), Window.GetY(), 0);

# Use White (1, 1, 1) and Acid Green (0.81, 1.0, 0.0)
veil_image = Image.Text("................................................................................................................................................................................................", 1, 1, 1, 0.15, "Monospace 10", "left");
veil = Sprite(veil_image);
veil.SetZ(20);

scan_image = Image.Text(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>", 0.81, 1.0, 0.0, 0.45, "Monospace Bold 12", "left");
scan = Sprite(scan_image);
scan.SetZ(30);

title_image = Image.Text("// ctOS INITIALIZATION SEQUENCE", 1, 1, 1, 1, "Monospace Bold 22", "left");
title_shadow_image = Image.Text("// ctOS INITIALIZATION SEQUENCE", 0.81, 1.0, 0.0, 0.45, "Monospace Bold 22", "left");
title = Sprite(title_image);
title_shadow = Sprite(title_shadow_image);
title.SetZ(50);
title_shadow.SetZ(49);

status_text = [];
status_image = [];
status_sprite = [];
status_text[0] = "[ OK ] Loading core modules";
status_text[1] = "[ OK ] Mounting encrypted filesystems";
status_text[2] = "[ OK ] Establishing secure link";
status_text[3] = "[ OK ] Validating environment";
status_text[4] = "[ OK ] Activating Wayland compositors";
status_text[5] = "[ OK ] ctOS ready for login";

for (i = 0; i < 6; i++) {
    status_image[i] = Image.Text(status_text[i], 0.81, 1.0, 0.0, 0.9, "Monospace 13", "left");
    status_sprite[i] = Sprite(status_image[i]);
    status_sprite[i].SetZ(55);
}

progress_image = [];
progress_image[0] = Image.Text("[                    ]", 1, 1, 1, 1, "Monospace Bold 16", "left");
progress_image[1] = Image.Text("[###                 ]", 1, 1, 1, 1, "Monospace Bold 16", "left");
progress_image[2] = Image.Text("[######              ]", 1, 1, 1, 1, "Monospace Bold 16", "left");
progress_image[3] = Image.Text("[#########           ]", 1, 1, 1, 1, "Monospace Bold 16", "left");
progress_image[4] = Image.Text("[############        ]", 1, 1, 1, 1, "Monospace Bold 16", "left");
progress_image[5] = Image.Text("[###############     ]", 1, 1, 1, 1, "Monospace Bold 16", "left");
progress_image[6] = Image.Text("[##################  ]", 1, 1, 1, 1, "Monospace Bold 16", "left");
progress_image[7] = Image.Text("[####################]", 1, 1, 1, 1, "Monospace Bold 16", "left");
progress = Sprite(progress_image[0]);
progress.SetZ(60);

signal_image = [];
signal_image[0] = Image.Text("INITIALIZING ctOS DAEMONS...", 1, 1, 1, 0.85, "Monospace Bold 13", "left");
signal_image[1] = Image.Text("INITIALIZING SYSTEM RAIL...", 1, 1, 1, 0.85, "Monospace Bold 13", "left");
signal_image[2] = Image.Text("CONNECTING TO BLUME SERVERS...", 0.81, 1.0, 0.0, 0.85, "Monospace Bold 13", "left");
signal = Sprite(signal_image[0]);
signal.SetZ(65);

frame = 0;

fun refresh_callback() {
    frame++;

    pulse = (Math.Sin(frame / 7) + 1) / 2;
    flicker = (Math.Sin(frame * 3) + 1) / 2;
    jitter = Math.Int(Math.Sin(frame * 2.7) * 2);

    # Slightly dial back the background opacity so text pops
    background.SetOpacity(0.60 + (flicker * 0.10));

    veil.SetX(Window.GetX());
    veil.SetY(Window.GetY() + ((frame * 5) % screen_h));
    veil.SetOpacity(0.08 + (pulse * 0.12));

    scan.SetX(Window.GetX());
    scan.SetY(Window.GetY() + ((frame * 11) % screen_h));
    scan.SetOpacity(0.18 + (pulse * 0.22));

    title_x = Window.GetX() + (screen_w * 0.05);
    title_y = Window.GetY() + (screen_h * 0.07);
    title.SetPosition(title_x, title_y, 50);
    title.SetOpacity(0.85 + (pulse * 0.15));
    title_shadow.SetPosition(title_x + Math.Int(Math.Sin(frame) * 4), title_y + 2, 49);
    title_shadow.SetOpacity(flicker * 0.35);

    for (i = 0; i < 6; i++) {
        status_sprite[i].SetX(Window.GetX() + (screen_w * 0.06));
        status_sprite[i].SetY(Window.GetY() + (screen_h * 0.62) + (i * 20));
        status_sprite[i].SetOpacity(0.65 + (((frame + i * 9) % 40) / 80));
    }

    progress.SetX(Window.GetX() + (screen_w / 2) - (progress_image[0].GetWidth() / 2));
    progress.SetY(Window.GetY() + (screen_h * 0.91));
    progress.SetImage(progress_image[Math.Int(frame / 5) % 8]);
    progress.SetOpacity(0.8 + (pulse * 0.2));

    signal.SetX(Window.GetX() + (screen_w * 0.64));
    signal.SetY(Window.GetY() + (screen_h * 0.78));
    signal.SetImage(signal_image[Math.Int(frame / 18) % 3]);
    signal.SetOpacity(0.65 + (flicker * 0.35));

    Plymouth.SetRefreshFunction(refresh_callback);
}

Plymouth.SetRefreshFunction(refresh_callback);
